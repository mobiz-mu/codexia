# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@codexia.mu
EMAIL_REPLY_TO=support@codexia.mu

# Google Calendar (service account)
# Base64-encode the service account JSON key file: base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_CALENDAR_ID=

# Cron (sent as a header by Vercel Cron; verify it in /api/cron/* handlers)
CRON_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=https://www.codexia.mu

# Optional analytics
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# PayPal (client-side publishable ID — safe to expose in the browser bundle).
# The booking flow uses PayPal Smart Buttons for UI only; order creation and
# capture happen server-side via the Orders API (lib/payments/paypal-client.ts),
# verified against PAYPAL_CLIENT_SECRET before a booking is ever confirmed.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# PayPal server-side credentials (never exposed to the browser). Get these
# from the same PayPal app as the client id above.
PAYPAL_CLIENT_SECRET=
# Webhook ID from the PayPal app's webhook subscription, used to verify
# incoming webhook signatures (app/api/webhooks/paypal/route.ts).
PAYPAL_WEBHOOK_ID=
# "sandbox" | "live" — selects the PayPal API base URL. Use sandbox for all
# testing; only switch to live once ready to accept real payments.
PAYPAL_ENVIRONMENT=sandbox

# Error tracking — reserved for a future Sentry integration (not yet wired
# up; setting these has no effect until @sentry/nextjs is installed and
# configured). See docs/SETUP.md.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
